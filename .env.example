# Shared dashboard password. Required — the server refuses to boot without it.
DASHBOARD_PASSWORD=change-me

# Local dev: leave DATABASE_URL unset to use the embedded Postgres (PGlite) in .pgdata/
# Deployed: set this to the Render/Railway Postgres connection string.
# DATABASE_URL=postgres://user:pass@host:5432/webhook_catcher

PORT=3000

# Requests older than this many days are deleted by a daily cleanup (and once on boot).
# Optional — defaults to 30. Must be a whole number >= 1.
# RETENTION_DAYS=30
